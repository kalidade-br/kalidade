javascript:(async()=>{try{let v=document.querySelector('video');if(!v)return alert('Vídeo não encontrado');let u=v.src||v.currentSrc;if(!u)return alert('URL do vídeo não encontrada');if(!u.includes('.m3u8'))return open(u,'_blank');let m=await fetch(u).then(r=>r.text());let b=u.substring(0,u.lastIndexOf('/')+1);let seg=m.split('\n').filter(x=>x&&!x.startsWith('#'));if(!seg.length)return alert('Segmentos não encontrados');let arr=[],size=0;for(let i=0;i<seg.length;i++){let url=seg[i].startsWith('http')?seg[i]:b+seg[i];let buf=await fetch(url).then(r=>r.arrayBuffer());let part=new Uint8Array(buf);arr.push(part);size+=part.length}let out=new Uint8Array(size),pos=0;for(let p of arr){out.set(p,pos);pos+=p.length}let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([out],{type:'video/mp2t'}));a.download='video.ts';a.click()}catch(e){alert(e)}})();
